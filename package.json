{
  "name": "designflow-pro",
  "version": "0.1.0",
  "description": "Professional AI-assisted collaborative design platform for creative professionals",
  "main": "public/electron.js",
  "homepage": "./",
  "author": "DesignFlow Team",
  "license": "MIT",
  "scripts": {
    "react-start": "react-scripts start",
    "react-build": "react-scripts build",
    "react-test": "react-scripts test",
    "react-eject": "react-scripts eject",
    "dev": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "npm run react-build && electron-builder",
    "build:win": "npm run react-build && electron-builder --win",
    "build:mac": "npm run react-build && electron-builder --mac",
    "build:linux": "npm run react-build && electron-builder --linux",
    "predist": "npm run react-build",
    "dist": "electron-builder"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "zustand": "^4.4.0",
    "framer-motion": "^10.16.0",
    "three": "^r128",
    "pixi.js": "^7.2.0",
    "socket.io-client": "^4.6.0",
    "openai": "^4.0.0",
    "axios": "^1.5.0",
    "lucide-react": "^0.263.0",
    "classnames": "^2.3.2"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.4.0",
    "typescript": "^5.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/node": "^20.5.0",
    "concurrently": "^8.2.0",
    "wait-on": "^7.0.1",
    "tailwindcss": "^3.3.0",
    "postcss": "^8.4.28",
    "autoprefixer": "^10.4.16"
  },
  "build": {
    "appId": "com.designflow.pro",
    "productName": "DesignFlow Pro",
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "public/electron.js",
      "public/preload.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "certificateFile": null,
      "certificatePassword": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
